<?xml version="1.0" encoding="utf-8"?>
<!--
  OpenCode logomark, traced from the launcher art.

  Source: logo/icon logo.png (1254x1254 raster) and the launcher
  foreground mipmap-xxxhdpi/ic_launcher_foreground.png (432x432, transparent
  background) — the same isometric cube mark: off-white top/bottom faces,
  lime right face, two lime antennae. There is no vector source in the repo,
  so this is a simplified hand trace of the raster (see the pixel map in the
  Phase 1 report), not a pixel-perfect conversion.

  The mark sits on its own near-black rounded tile (#07080C, sampled from
  logo/icon logo.png) so the off-white faces stay legible in BOTH themes:
  on a light surface the bare white faces would vanish. The tile corners
  (24/108) match the app icon's rounded square. Used at exactly three sizes:
  hero 40dp (ChatScreen), drawer profile 30dp (ChatScreen), provenance
  fallback 20dp (Provenance.kt).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- App-icon tile -->
    <path
        android:fillColor="#07080C"
        android:pathData="M28,4 H80 A24,24 0 0 1 104,28 V80 A24,24 0 0 1 80,104 H28 A24,24 0 0 1 4,80 V28 A24,24 0 0 1 28,4 Z" />
    <!-- Top face + left spine (one connected off-white shape) -->
    <path
        android:fillColor="#F0F0E0"
        android:pathData="M55,30 L73,38 L56,46 L56,52 L45,57 L44,61 L39,61 L33,57 L33,44 L41,37 Z" />
    <!-- Bottom chevron -->
    <path
        android:fillColor="#F0F0E0"
        android:pathData="M32,63 L54,72 L66,64 L66,70 L56,82 Q54,83 52,82 L34,70 Q32,68 32,66 Z" />
    <!-- Right face -->
    <path
        android:fillColor="#B0F020"
        android:pathData="M63,47 L73,40 L76,42 L76,71 L73,75 L63,70 Z" />
    <!-- Antennae -->
    <path
        android:strokeColor="#B0F020"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M45,32 L40,25" />
    <path
        android:strokeColor="#B0F020"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M63,32 L68,25" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- #12, audit-200 D4 (m-014): the launch window follows the SYSTEM
         light theme until MainActivity applies the pinned theme in
         onCreate — a Light pin on a Dark system still flashes this light
         window for one frame before that call. The bars are transparent —
         edge-to-edge is on (MainActivity) — and the light-bar flags match
         the light background; the runtime SideEffect in OpenCodeTheme
         re-asserts them whenever the app theme changes. -->
    <style name="Theme.OpenCode" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#F9F9FA</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Voice input (Composer C): the composer's mic records through the
      platform speech recognizer. Requested at runtime, only when the mic
      is tapped; a denial just leaves voice input off. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      The engine needs a real POSIX path, not a content:// URI, so the user's
      project directory has to be readable and writable directly. This is the
      storage decision recorded in handoff.md §3 (D2); it is why the app ships
      through GitHub Releases and not Google Play.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
      MANAGE_EXTERNAL_STORAGE only exists from API 30. minSdk is 29, so Android 10
      still needs the legacy pair, plus requestLegacyExternalStorage to opt out of
      scoped storage on that release.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!--
      The engine is a local server that must outlive the task. FOREGROUND_SERVICE
      is the base permission; FOREGROUND_SERVICE_SPECIAL_USE matches the declared
      service type below. POST_NOTIFICATIONS is requested for UX only: if the user
      denies it the service still runs, it just has no notification in the drawer.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".OpenCodeApplication"
        android:label="OpenCode"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.OpenCode"
        android:enableOnBackInvokedCallback="true">

        <!-- resizeableActivity (Batch 7, multi-window): explicit even
          though it defaults to true at this targetSdk — split-screen and
          freeform resize must keep working, and configChanges above
          already keeps a resize from restarting the activity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Receive shared text (Native C): a link or text shared from
              any app opens here and becomes the draft of a fresh session.
              singleTop above keeps an already-open app from restarting:
              the share arrives through onNewIntent instead. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Deep link (Native C): opencode://session/{id} opens that
              session. Handled by the same intent path as the share above. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="opencode" android:host="session" />
            </intent-filter>
            <!-- Launcher shortcuts (Native C): long-press the app icon. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          specialUse rather than dataSync: dataSync is capped at 6 hours per 24 hours
          in the background, which is far shorter than a coding session. stopWithTask
          must be false so swiping the task away does not take the engine with it.
        -->
        <service
            android:name=".service.EngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="long_running_local_coding_agent_server" />
        </service>

        <!-- Home-screen widget (Native C): last session + New / Open. -->
        <receiver
            android:name=".ui.widget.SessionWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_session_info" />
        </receiver>
    </application>
</manifest>
